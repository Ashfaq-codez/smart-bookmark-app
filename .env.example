# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings -> API (both are safe to expose to the browser; protected by row level security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: Project Settings -> API (SECRET. Server only. Bypasses row level security. Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Chrome extension ID from brave://extensions or chrome://extensions (used to allow the extension in CORS)
CHROME_EXTENSION_ID=
