{
  "manifest_version": 3,
  "name": "Smart Bookmarks - Universal Save",
  "version": "1.0",
  "description": "1-click save to your Smart Bookmarks hub.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://smart-bookmark-app-lime.vercel.app/"
  ]
}